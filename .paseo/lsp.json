{
  "servers": {
    "typescript": {
      "command": "pnpx",
      "args": ["--package=typescript@latest", "--package=typescript-language-server@latest", "typescript-language-server", "--stdio"],
      "languages": {
        "ts": "typescript",
        "tsx": "typescriptreact",
        "js": "javascript",
        "jsx": "javascriptreact",
        "mjs": "javascript"
      },
      "initializationOptions": {
        "tsserver": { "useSyntaxServer": "never" }
      }
    },
    "python": {
      "command": "pnpx",
      "args": ["--package=basedpyright@latest", "basedpyright-langserver", "--stdio"],
      "languages": { "py": "python", "pyi": "python" }
    }
  }
}
