{
  "servers": {
    "typescript": {
      "command": "./plugins/lsp/node_modules/.bin/typescript-language-server",
      "args": ["--stdio"],
      "languages": {
        "ts": "typescript",
        "tsx": "typescriptreact",
        "js": "javascript",
        "jsx": "javascriptreact",
        "mjs": "javascript"
      },
      "initializationOptions": {
        "tsserver": { "useSyntaxServer": "never" }
      }
    },
    "python": {
      "command": "./plugins/lsp/node_modules/.bin/basedpyright-langserver",
      "args": ["--stdio"],
      "languages": { "py": "python", "pyi": "python" }
    }
  }
}
